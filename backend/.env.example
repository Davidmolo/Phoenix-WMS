PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/phoenix_wms
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Email (portal invites / invoice mail) — use your own SMTP provider values
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Phoenix Cross Dock <noreply@example.com>
# Cesar / dock ops — emailed on every new website or portal booking / info request
BOOKING_NOTIFY_EMAIL=cesar@phoenixcrossdocks.com
# Cesar Oct 12: keep false until warehouse is ready (public site = request for info only)
PUBLIC_BOOKING_ENABLED=false
# BOL signed HTML + exception photos (local disk)
UPLOADS_DIR=uploads

# QuickBooks Online — leave blank locally; set real values only on the server
# Never commit real Client ID / Client Secret
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://wms.phoenixcrossdocks.com/api/quickbooks/callback
QUICKBOOKS_ENV=sandbox
# Set false to keep all invoices in WMS only (no QBO create) — safer for audits/tests
QUICKBOOKS_PUSH_ENABLED=true
QUICKBOOKS_SYNC_ENABLED=true
QUICKBOOKS_SYNC_CRON=*/5 * * * *
QUICKBOOKS_SYNC_ON_BOOT=true
# Intuit Developer → Webhooks verifier token (optional but recommended)
# Endpoint: https://wms.phoenixcrossdocks.com/api/quickbooks/webhook
QUICKBOOKS_WEBHOOK_VERIFIER_TOKEN=
# Invoice flow (Cesar): WMS → QB create + QB emails invoice (Pay Now); QB→WMS via webhook + cron.
# Map fee types → QBO Item Id/Name on Company.quickbooksItemMap (default Item name: Services).
# Every customer must have an email on WMS before invoicing.
# Optional Zelle line on SMTP fallback invoices (when QB send is unavailable / test customer)
# ZELLE_PAY_HINT=Pay via Zelle to … Include the invoice number in the memo.
# NMI sandbox merchant keys. Private key stays on the server. Public key is sent to the payment page.
NMI_SECURITY_KEY=
NMI_TOKENIZATION_KEY=
NMI_API_BASE=https://sandbox.nmi.com/api/v5
