PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/phoenix_wms
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Required to email portal invites (Google Workspace / Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=notifications@phoenixcrossdocks.com
SMTP_PASS=your-16-char-app-password
MAIL_FROM=Phoenix Cross Dock <notifications@phoenixcrossdocks.com>

# QuickBooks Online (never commit real secrets)
# Sandbox: Keys → Development + QUICKBOOKS_ENV=sandbox
# Live:    Keys → Production  + QUICKBOOKS_ENV=production
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REDIRECT_URI=https://wms.phoenixcrossdocks.com/api/quickbooks/callback
QUICKBOOKS_ENV=sandbox
# Auto-sync invoices into Mongo (staff can still Sync manually on Billing)
QUICKBOOKS_SYNC_ENABLED=true
# Every 15 minutes (5-field cron: min hour dom month dow)
QUICKBOOKS_SYNC_CRON=*/15 * * * *
# Run one sync ~15s after API boot
QUICKBOOKS_SYNC_ON_BOOT=true
